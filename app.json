{
  "expo": {
    "name": "Watt",
    "slug": "EXPO1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "backgroundColor": "#FAF7F2",
    "primaryColor": "#F59E0B",
    "scheme": "expo1",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F59E0B",
        "foregroundImage": "./assets/images/brand-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.pbl1.watt"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 설정하거나 캡처 이미지에서 아이디어를 추출할 수 있도록 사진 접근을 허용해 주세요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/images/brand-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FAF7F2",
            "image": "./assets/images/brand-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#F59E0B",
          "defaultChannel": "personal"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08b2475f-6b65-46c0-8400-19d2de21cb8f"
      }
    },
    "owner": "jimmyapron"
  }
}
